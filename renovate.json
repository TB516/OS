{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:githubDigestChangelogs",
    "helpers:gitlabDigestChangelogs"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "automerge": false,
  "prHourlyLimit": 10,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/installer\\.yml$/"],
      "matchStrings": ["# renovate: datasource=git-refs depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\n          ref: (?<currentDigest>[a-f0-9]{40})"],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^elements/.*\\.bst$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\n  track: (?<currentValue>[^\\n]+)\\n  ref: (?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^elements/.*\\.bst$/"],
      "matchStrings": ["# renovate: datasource=git-refs depName=(?<depName>\\S+) packageName=(?<packageName>\\S+)\\n  track: (?<currentValue>[^\\n]+)\\n  ref: (?:[^\\n]*-g)?(?<currentDigest>[a-f0-9]{40})"],
      "datasourceTemplate": "git-refs",
      "autoReplaceStringTemplate": "# renovate: datasource=git-refs depName={{{depName}}} packageName={{{packageName}}}\n  track: {{{currentValue}}}\n  ref: {{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^elements/plugins/.*\\.bst$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-tags|gitlab-tags) depName=(?<depName>\\S+)\\n  track: (?<currentValue>[^\\n]+)\\n  ref: (?<currentDigest>[a-f0-9]{40})"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^include/(builder|chunkah)-image\\.txt$/"],
      "matchStrings": ["(?<depName>[^\\s]+):(?<currentValue>[^:@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/coreos/chunkah"],
      "sourceUrl": "https://github.com/coreos/chunkah"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/library/docker"],
      "changelogUrl": "https://docs.docker.com/engine/release-notes/"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.gitlab.com/freedesktop-sdk/infrastructure/freedesktop-sdk-docker-images/bst2"],
      "sourceUrl": "https://gitlab.com/freedesktop-sdk/infrastructure/freedesktop-sdk-docker-images"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/projectbluefin/dakota"],
      "commitMessageTopic": "Dakota kernel and Secure Boot files",
      "addLabels": ["kernel"],
      "sourceUrl": "https://github.com/projectbluefin/dakota",
      "prBodyNotes": [
        "Updates the signed kernel, matching modules and Secure Boot files imported from Dakota's image. Other Dakota recipes are pinned separately."
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "pinDigests": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner"],
      "enabled": false
    }
  ]
}
