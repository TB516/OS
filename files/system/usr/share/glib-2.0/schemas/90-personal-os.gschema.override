[org.gnome.desktop.default-applications.terminal]
exec='xdg-terminal-exec'
exec-arg='--'

[org.gnome.shell]
favorite-apps=['com.mitchellh.ghostty.desktop', 'org.gnome.Nautilus.desktop', 'io.github.kolunmi.Bazaar.desktop']
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'appindicatorsupport@rgcjonas.gmail.com', 'custom-command-list@storageb.github.com', 'bazaar-integration@kolunmi.github.io', 'gradia-integration@alexandervanhee.github.io', 'power-status-color@local']

[org.gnome.settings-daemon.plugins.media-keys]
home=['<Super>e']

[org.gnome.desktop.wm.keybindings]
switch-applications=['<Super>Tab']
switch-applications-backward=['<Shift><Super>Tab']
switch-windows=['<Alt>Tab']
switch-windows-backward=['<Shift><Alt>Tab']
